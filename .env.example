# Copia este archivo como .env y pega tu clave. NUNCA subas .env al repositorio.
# Proveedor compatible con la API de OpenAI (OpenRouter por defecto)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# Modelos en orden de preferencia (el 1° es el principal, los siguientes son fallback)
LLM_MODELS=inclusionai/ling-3.0-flash-vl:free,inclusionai/ling-3.0-flash-sante:free,nvidia/nemotron-3.5-lightning:free

# Reintentos: espera antes de reintentar el MISMO modelo y cuántos reintentos hacer antes de pasar al siguiente
LLM_RETRY_DELAY_SECONDS=0.1
LLM_RETRIES_PER_MODEL=1
LLM_TIMEOUT_SECONDS=60
LLM_BATCH_SIZE=25

# La IA es OPCIONAL. false = el pipeline no la usa (recomendado); se ejecuta a pedido desde la app o con --ai.
# true = al procesar un Excel nuevo se clasifica con IA lo que las reglas no resolvieron (por lotes; puede demorar)
LLM_AUTO_CLASSIFY=false

# ---------------- Base de datos
# supabase = Postgres en la nube (persistente y compartida) · sqlite = archivo local db/rla_products.db (respaldo offline)
DB_BACKEND=sqlite
SUPABASE_URL=https://<proyecto>.supabase.co
# Recomendado en producción: clave SECRETA (sb_secret_...) solo en el servidor. La publicable requiere las políticas del schema.
SUPABASE_KEY=
